# ── Hetzner Cloud (required) ─────────────────────────────────
HCLOUD_TOKEN=your_hetzner_api_token_here

# ── VM Configuration (optional) ──────────────────────────────
# SERVER_NAME is a prefix — actual server/OS hostname will be <prefix>-<6 random hex chars>
SERVER_NAME=hardened-node
SERVER_TYPE=cx22
LOCATION=fsn1
OS_IMAGE=ubuntu-26.04
# Public IPv6 for the VM (true/false). IPv4 is always created.
# false: no IPv6 address is allocated and the Hetzner firewall rules are IPv4-only.
# Note: the hardening scripts disable IPv6 inside the OS either way, so with
# true the address is reserved but not used by the host.
ENABLE_IPV6=true

# ── User (optional — random if blank) ────────────────────────
# Generated name format: svc_<8 hex chars>
NEW_USER_NAME=

# ── Email alerts via msmtp (optional) ────────────────────────
# If set, Phase 2 installs msmtp and wires it as the system MTA
# so logwatch, auditd, AIDE, and rkhunter can send reports.
# Requires an existing external SMTP relay with TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL=

# ── Availability poller (optional) ───────────────────────────
# Comma-separated server types to check from a daily host-side cron job.
POLL_SERVER_TYPES=cx22,cx23,cx33
# Comma-separated locations are supported, e.g. fsn1,nbg1,hel1.
POLL_LOCATION=fsn1
